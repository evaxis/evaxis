{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:evaxis:schema:collection-manifest:0.1",
  "title": "Evaxis Collection Manifest v0.1",
  "description": "Declares a collection run, intended scope, source attempts, visibility limits and collection coverage.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifestId",
    "contractVersion",
    "collectionRunId",
    "collector",
    "startedAt",
    "collectionStatus",
    "requestedScope",
    "sourceAttempts",
    "coverage"
  ],
  "properties": {
    "manifestId": {
      "$ref": "#/$defs/identifier"
    },
    "contractVersion": {
      "const": "0.1"
    },
    "collectionRunId": {
      "$ref": "#/$defs/identifier"
    },
    "collector": {
      "$ref": "#/$defs/producer"
    },
    "startedAt": {
      "type": "string",
      "format": "date-time"
    },
    "completedAt": {
      "type": "string",
      "format": "date-time"
    },
    "collectionStatus": {
      "enum": [
        "succeeded",
        "partial",
        "failed",
        "unsupported",
        "unavailable",
        "denied",
        "malformed",
        "not-attempted"
      ]
    },
    "requestedScope": {
      "$ref": "#/$defs/scope"
    },
    "sourceAttempts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/sourceAttempt"
      }
    },
    "coverage": {
      "$ref": "#/$defs/coverage"
    },
    "visibilityConstraints": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "description"],
        "properties": {
          "kind": {
            "enum": ["permission", "source-limit", "collector-limit", "clock", "other"]
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "reference": {
            "$ref": "#/$defs/identifier"
          }
        }
      }
    },
    "collectorConfiguration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version"],
      "properties": {
        "version": {
          "$ref": "#/$defs/identifier"
        },
        "configurationDigest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "extensions": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "collectionStatus": {
            "const": "succeeded"
          }
        },
        "required": ["collectionStatus"]
      },
      "then": {
        "required": ["completedAt"]
      }
    }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "digest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "value", "covers"],
      "properties": {
        "algorithm": {
          "$ref": "#/$defs/identifier"
        },
        "value": {
          "type": "string",
          "minLength": 1
        },
        "covers": {
          "$ref": "#/$defs/identifier"
        }
      }
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority", "id", "version", "identityStatus"],
      "properties": {
        "authority": {
          "$ref": "#/$defs/identifier"
        },
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "version": {
          "$ref": "#/$defs/identifier"
        },
        "identityStatus": {
          "enum": ["asserted", "authenticated", "unverified", "invalid", "unknown"]
        },
        "identityMethod": {
          "$ref": "#/$defs/identifier"
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority", "scopeId"],
      "properties": {
        "authority": {
          "$ref": "#/$defs/identifier"
        },
        "scopeId": {
          "$ref": "#/$defs/identifier"
        },
        "scopeType": {
          "$ref": "#/$defs/identifier"
        },
        "description": {
          "type": "string"
        }
      }
    },
    "targetReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority", "scopeId", "nativeId"],
      "properties": {
        "authority": {
          "$ref": "#/$defs/identifier"
        },
        "scopeId": {
          "$ref": "#/$defs/identifier"
        },
        "nativeId": {
          "$ref": "#/$defs/identifier"
        },
        "displayName": {
          "type": "string"
        }
      }
    },
    "sourceAttempt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority", "status"],
      "properties": {
        "authority": {
          "$ref": "#/$defs/identifier"
        },
        "status": {
          "enum": ["succeeded", "failed", "unsupported", "unavailable", "denied", "malformed", "not-attempted"]
        },
        "startedAt": {
          "type": "string",
          "format": "date-time"
        },
        "completedAt": {
          "type": "string",
          "format": "date-time"
        },
        "limitation": {
          "type": "string"
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "expectedTargets", "observedTargets", "notObserved"],
      "properties": {
        "status": {
          "enum": ["complete", "partial", "unknown"]
        },
        "expectedTargets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/targetReference"
          }
        },
        "observedTargets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/targetReference"
          }
        },
        "notObserved": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["target", "reason"],
            "properties": {
              "target": {
                "$ref": "#/$defs/targetReference"
              },
              "reason": {
                "enum": ["denied", "unavailable", "unsupported", "not-attempted", "unknown"]
              }
            }
          }
        }
      }
    }
  }
}
